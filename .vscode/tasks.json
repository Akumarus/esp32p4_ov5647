{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start OpenOCD",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f", "interface/jlink.cfg",
                "-c", "transport select jtag; adapter speed 10000",
                "-f", "target/esp32p4.cfg"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Info : Listening on port 3333",
                    "endsPattern": "^Info : Listening on port 3333"
                }
            }
        },
        {
            "label": "Stop OpenOCD",
            "type": "shell",
            "command": "pkill",
            "args": ["-f", "openocd"]
        }
    ]
}